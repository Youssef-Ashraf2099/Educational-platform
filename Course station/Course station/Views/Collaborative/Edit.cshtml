@model Course_station.Models.Collaborative

@{
    ViewData["Title"] = "Edit Collaborative";
}

<h1>Edit Collaborative</h1>

<h4>Collaborative</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div class="form-group">
                <label asp-for="QuestId" class="control-label"></label>
                <input asp-for="QuestId" class="form-control" readonly />
                <span asp-validation-for="QuestId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Deadline" class="control-label"></label>
                <input asp-for="Deadline" class="form-control" />
                <span asp-validation-for="Deadline" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MaxNumParticipants" class="control-label"></label>
                <input asp-for="MaxNumParticipants" class="form-control" />
                <span asp-validation-for="MaxNumParticipants" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
