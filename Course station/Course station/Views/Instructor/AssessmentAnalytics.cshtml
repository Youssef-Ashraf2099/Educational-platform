@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Assessment Analytics";
}

<h2>Assessment Analytics</h2>

@if (!Model.Any())
{
    <p>No data available.</p>
}

@foreach (var item in Model)
{
    <div>
        <h4>@item.Assessment.Title</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@item.Assessment.Description</dd>
            <dt class="col-sm-2">Total Marks</dt>
            <dd class="col-sm-10">@item.Assessment.TotalMarks</dd>
            <dt class="col-sm-2">Passing Marks</dt>
            <dd class="col-sm-10">@item.Assessment.PassingMarks</dd>
        </dl>
    </div>

    <h3>Score Analytics</h3>
    <div>
        <dl class="row">
            <dt class="col-sm-2">Average Score</dt>
            <dd class="col-sm-10">@item.AverageScore</dd>
            <dt class="col-sm-2">Highest Score</dt>
            <dd class="col-sm-10">@item.HighestScore</dd>
            <dt class="col-sm-2">Lowest Score</dt>
            <dd class="col-sm-10">@item.LowestScore</dd>
        </dl>
    </div>

    <h3>Taken Assessments</h3>
    <div>
        <table class="table">
            <thead>
                <tr>
                    <th>Learner</th>
                    <th>Score</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var takenAssessment in item.Assessment.TakenAssessments)
                {
                    <tr>
                        <td>@takenAssessment.Learner.FirstName @takenAssessment.Learner.LastName</td>
                        <td>@takenAssessment.ScoredPoint</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
