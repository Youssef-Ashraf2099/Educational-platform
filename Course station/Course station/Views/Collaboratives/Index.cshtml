@model IEnumerable<Course_station.Models.Collaborative>

@{
    ViewData["Title"] = "Collaboratives";
}

<h1>Collaboratives</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.QuestId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Deadline)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MaxNumParticipants)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.QuestId)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Deadline)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.MaxNumParticipants)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.QuestId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.QuestId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.QuestId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
