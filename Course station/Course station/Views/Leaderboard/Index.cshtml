@model IEnumerable<Course_station.Models.Leaderboard>

@{
    ViewData["Title"] = "Leaderboards";
}

<h1 class="text-center">Leaderboards</h1>
<hr />

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">Board ID: @item.BoardId</h5>
                    <p class="card-text">Season: @item.Season</p>
                    <a asp-action="Details" asp-route-id="@item.BoardId" class="btn btn-primary">Rankings</a>
                </div>
            </div>
        </div>
    }
</div>
