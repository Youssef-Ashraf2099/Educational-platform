@section Scripts {
    <script>
        async function generateQuestion() {
            console.log("generateQuestion function triggered."); // Debug: Function entry

            const inputText = document.getElementById("inputText").value;
            console.log("Input text:", inputText); // Debug: Log input text

            if (!inputText) {
                alert("Please enter some text.");
                console.error("Input text is empty."); // Debug: Log empty input error
                return;
            }

            const endpoints = [
                { url: '/api/Chatbot/generate-question', type: 'General Question', elementId: 'generalQuestion' },
                { url: '/api/Chatbot/generate-mcq', type: 'MCQ', elementId: 'mcqQuestion' },
                { url: '/api/Chatbot/generate-truefalse', type: 'True/False', elementId: 'trueFalseQuestion' },
                { url: '/api/Chatbot/generate-coding', type: 'Coding Question', elementId: 'codingQuestion' }
            ];

            for (const endpoint of endpoints) {
                console.log(`Calling endpoint: ${endpoint.url} for ${endpoint.type}`); // Debug: Log endpoint being called

                try {
                    // Important fix: Send text as a property of an object
                    const response = await fetch(endpoint.url, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ text: inputText })
                    });

                    console.log(`Response status for ${endpoint.type}:`, response.status); // Debug: Log response status

                    if (response.ok) {
                        const data = await response.json();
                        console.log(`Response data for ${endpoint.type}:`, data); // Debug: Log response data

                        let output = '';

                        if (endpoint.type === 'MCQ') {
                            output = `
                                <strong>Question:</strong> ${data.question}<br>
                                <strong>Options:</strong><br>
                                A) ${data.options[0]}<br>
                                B) ${data.options[1]}<br>
                                C) ${data.options[2]}<br>
                                D) ${data.options[3]}<br>
                                <strong>Correct Answer:</strong> ${data.correctAnswer}
                            `;
                        } else if (endpoint.type === 'True/False') {
                            output = `
                                <strong>Statement:</strong> ${data.statement}<br>
                                <strong>Correct Answer:</strong> ${data.correctAnswer}
                            `;
                        } else {
                            output = `<strong>${endpoint.type}:</strong> ${data.question}`;
                        }

                        document.getElementById(endpoint.elementId).innerHTML = output;
                        console.log(`Output for ${endpoint.type} updated successfully.`); // Debug: Log successful update
                    } else {
                        const errorText = await response.text();
                        console.error(`Error response for ${endpoint.type}:`, errorText); // Debug: Log error response
                        document.getElementById(endpoint.elementId).innerHTML = `<span class="text-danger">Failed to generate ${endpoint.type}. Please try again.</span>`;
                    }
                } catch (error) {
                    console.error(`Exception for ${endpoint.type}:`, error); // Debug: Log exception
                    document.getElementById(endpoint.elementId).innerHTML = `<span class="text-danger">Error: ${error.message}</span>`;
                }
            }
        }
    </script>
}

<div class="card mb-4">
    <div class="card-header">
        <h4>Generate a Question</h4>
    </div>
    <div class="card-body">
        <textarea id="inputText" class="form-control" rows="4" placeholder="Enter text here..."></textarea>
        <button class="btn btn-primary mt-3" onclick="generateQuestion()">Generate Questions</button>
        <div class="mt-3">
            <h5>General Question</h5>
            <p id="generalQuestion" class="text-success"></p>

            <h5>MCQ</h5>
            <p id="mcqQuestion" class="text-success"></p>

            <h5>True/False Question</h5>
            <p id="trueFalseQuestion" class="text-success"></p>

            <h5>Coding Question</h5>
            <p id="codingQuestion" class="text-success"></p>
        </div>
    </div>
</div>