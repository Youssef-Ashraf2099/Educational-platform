@model Course_station.Controllers.LearnersController.JoinQuestViewModel
@{
    ViewData["Title"] = "Quest Content";
}

<h2>Quest Content: @Model.Quest.Title</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="card mb-4">
    <div class="card-header">
        <h4>Quest Details</h4>
    </div>
    <div class="card-body">
        <p><strong>Description:</strong> @Model.Quest.Description</p>
        <p><strong>Difficulty:</strong> @Model.Quest.DifficultyLevel</p>
        <p><strong>Criteria:</strong> @Model.Quest.Criteria</p>
    </div>
</div>

@if (Model.LearnerQuest?.Status == "Completed")
{
    <div class="alert alert-info">
        <h4>Quest Completed</h4>
        <p>Congratulations! You have successfully completed this quest.</p>
    </div>
}
else if (Model.LearnerQuest?.Status == "In Progress")
{
    <div class="card mb-4">
        <div class="card-header">
            <h4>Generate a Question</h4>
        </div>
        <div class="card-body">
            <textarea id="inputText" class="form-control" rows="4" placeholder="Enter text here..."></textarea>
            <button class="btn btn-primary mt-3" onclick="generateQuestion()">Generate Question</button>
            <div class="mt-3">
                <p id="generatedQuestion" class="text-success"></p>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">
        <p>You haven't joined this quest yet.</p>
        <a asp-action="JoinQuest" asp-route-learnerId="@Model.LearnerId" asp-route-questId="@Model.Quest.QuestId" class="btn btn-primary">Join This Quest</a>
    </div>
}

<a asp-action="AvailableQuests" asp-route-learnerId="@Model.LearnerId" class="btn btn-secondary mt-3">Back to Quests</a>

@section Scripts {
    <script>
        async function generateQuestion() {
            const inputText = document.getElementById("inputText").value;
            const response = await fetch('/api/Chatbot/generate-question', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(inputText)
            });

            if (response.ok) {
                const data = await response.json();
                document.getElementById("generatedQuestion").innerText = "Generated Question: " + data.question;
            } else {
                alert("Failed to generate a question. Please try again.");
            }
        }
    </script>
}
