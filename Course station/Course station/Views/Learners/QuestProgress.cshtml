@model IEnumerable<Course_station.Models.LearnerQuest>

@{
    ViewData["Title"] = "Quest Progress";
}

<h1>Quest Progress</h1>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="card">
    <div class="card-header">
        <h2>Quests</h2>
    </div>
    <div class="card-body">
        <table class="table table-striped table-hover">
            <thead class="thead-dark">
                <tr>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Difficulty Level</th>
                    <th>Criteria</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var learnerQuest in Model)
                {
                    <tr>
                        <td>@learnerQuest.Quest.Title</td>
                        <td>@learnerQuest.Quest.Description</td>
                        <td>@learnerQuest.Quest.DifficultyLevel</td>
                        <td>@learnerQuest.Quest.Criteria</td>
                        <td>@learnerQuest.Status</td>
                        <td>
                            <a asp-action="QuestContent" asp-route-learnerId="@ViewBag.LearnerId" asp-route-questId="@learnerQuest.QuestId" class="btn btn-primary btn-sm">View</a>
                            @if (learnerQuest.Status != "Completed")
                            {
                                <a asp-action="JoinQuest" asp-route-learnerId="@ViewBag.LearnerId" asp-route-questId="@learnerQuest.QuestId" class="btn btn-success btn-sm">Join</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<a asp-action="Home" class="btn btn-secondary mt-3">Back to Home</a>
