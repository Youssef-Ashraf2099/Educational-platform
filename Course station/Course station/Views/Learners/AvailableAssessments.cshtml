@model IEnumerable<Course_station.Models.Assessment>

@{
    ViewData["Title"] = "Available Assessments";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Available Assessments</h2>
        <a href="@Url.Action("Home", "Learners")" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Home
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No assessments are currently available for your enrolled courses.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="thead-light">
                    <tr>
                        <th>Title</th>
                        <th>Type</th>
                        <th>Course</th>
                        <th>Module</th>
                        <th>Total Marks</th>
                        <th>Passing Marks</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Title</td>
                            <td>@item.Type</td>
                            <td>
                                @if (item.CourseId != null)
                                {
                                    @(item.Module?.Course?.Title ?? "Direct Course Assessment")
                                }
                                else
                                {
                                    @(item.Module?.Course?.Title ?? "Unknown Course")
                                }
                            </td>
                            <td>@(item.Module?.Title ?? "N/A")</td>
                            <td>@item.TotalMarks</td>
                            <td>@item.PassingMarks</td>
                            <td>
                                <div class="btn-group">
                                    <a asp-controller="Assessments" asp-action="Details" asp-route-id="@item.AssessmentId"
                                       class="btn btn-sm btn-info" title="View Details">
                                        <i class="fas fa-eye"></i> Details
                                    </a>
                                    <a asp-controller="Assessments" asp-action="Take" asp-route-id="@item.AssessmentId" asp-route-learnerId="@ViewBag.LearnerId"
                                       class="btn btn-sm btn-success" title="Take Assessment">
                                        <i class="fas fa-pencil-alt"></i> Take
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Styles {
    <style>
        .btn-group {
            display: flex;
            gap: 0.25rem;
        }

            .btn-group .btn {
                padding: 0.25rem 0.5rem;
            }

        .table td {
            vertical-align: middle;
        }

        .thead-light th {
            background-color: #f8f9fa;
            border-color: #dee2e6;
        }
    </style>
}