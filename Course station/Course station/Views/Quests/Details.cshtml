@model Course_station.Models.Quest

@{
    ViewData["Title"] = "Quest Details";
    var deadline = ViewBag.Deadline as DateTime?;
    var learnerId = Context.Session.GetInt32("LearnerId");
}

<div class="container mt-4">
    <h1>Quest Details</h1>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">
            @TempData["Message"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card mb-4">
        <div class="card-header">
            <h3>@Model.Title</h3>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Difficulty Level</dt>
                <dd class="col-sm-9">@Model.DifficultyLevel</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Description</dd>

                <dt class="col-sm-3">Criteria</dt>
                <dd class="col-sm-9">@Model.Criteria</dd>

                @* @if (!string.IsNullOrEmpty(Model.SkillMastery)) *@
                @* { *@
                @*     <dt class="col-sm-3">Skill Mastery</dt> *@
                @*     <dd class="col-sm-9">@Model.SkillMastery</dd> *@
                @* } *@

                @if (deadline.HasValue)
                {
                    <dt class="col-sm-3">Deadline</dt>
                    <dd class="col-sm-9">@deadline.Value.ToString("MMM dd, yyyy - HH:mm")</dd>
                }

                @if (Model.Collaborative != null)
                {
                    <dt class="col-sm-3">Collaborative Quest</dt>
                    <dd class="col-sm-9">Yes</dd>

                    <dt class="col-sm-3">Maximum Participants</dt>
                    <dd class="col-sm-9">@Model.Collaborative.MaxNumParticipants</dd>
                }
            </dl>
        </div>
        <div class="card-footer">
            @if (learnerId.HasValue && Model.Collaborative != null)
            {
                <form asp-controller="Quests" asp-action="Join" method="post">
                    <input type="hidden" name="questId" value="@Model.QuestId" />
                    <input type="hidden" name="learnerId" value="@learnerId" />
                    <button type="submit" class="btn btn-success">Join Quest</button>
                </form>
            }
            
            <a asp-action="Participants" asp-route-id="@Model.QuestId" class="btn btn-info mt-2">View Participants</a>
            <a asp-action="Index" class="btn btn-secondary mt-2">Back to List</a>
        </div>
    </div>
</div>