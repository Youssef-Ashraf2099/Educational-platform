@model IEnumerable<Course_station.Models.Assessment>

@{
    ViewData["Title"] = "Available Assessments";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Available Assessments</h2>
        <a href="@Url.Action("Home", "Learners")" class="btn btn-secondary">
            Back to Home
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="thead-light">
                <tr>
                    <th>Title</th>
                   
                    <th>Total Marks</th>
                    <th>Passing Marks</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>@item.Type</td>
                        <td>@item.TotalMarks</td>
                        <td>@item.PassingMarks</td>
                        <td>
                            <div class="btn-group">
                                <a asp-controller="Assessments" asp-action="Details" asp-route-id="@item.AssessmentId"
                                   class="btn btn-sm btn-info">
                                    Details
                                </a>
                                <a asp-controller="Assessments" asp-action="Take" asp-route-id="@item.AssessmentId" asp-route-learnerId="@ViewBag.LearnerId"
                                   class="btn btn-sm btn-success">
                                    Take
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>