@model Course_station.Controllers.LearnersController.JoinQuestViewModel
@{
    ViewData["Title"] = "Confirm Join Quest";
}

<h2>Confirm Joining Quest</h2>
@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<table class="table table-bordered">
    <tr><th>Title</th><td>@Model.Quest.Title</td></tr>
    <tr><th>Description</th><td>@Model.Quest.Description</td></tr>
    <tr><th>Difficulty</th><td>@Model.Quest.DifficultyLevel</td></tr>
    <tr><th>Criteria</th><td>@Model.Quest.Criteria</td></tr>
</table>

@if (Model.LearnerQuest?.Status == "Completed")
{
    <div class="alert alert-info">You have completed this quest.</div>
}
else if (Model.LearnerQuest?.Status == "In Progress")
{
    <div class="alert alert-warning">This quest is currently in progress.</div>
    <a asp-action="QuestContent" asp-route-learnerId="@Model.LearnerId" asp-route-questId="@Model.Quest.QuestId" class="btn btn-primary">Continue Quest</a>
}
else
{
    <form asp-action="ConfirmJoinQuest" asp-controller="Learners" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="learnerId" value="@Model.LearnerId" />
        <input type="hidden" name="questId" value="@Model.Quest.QuestId" />
        <button type="submit" class="btn btn-primary">Confirm Join</button>
        <a asp-action="AvailableQuests" asp-route-learnerId="@Model.LearnerId" class="btn btn-secondary">Cancel</a>
    </form>
}
