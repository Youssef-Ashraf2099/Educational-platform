@section Scripts {
    <script>
        async function generateQuestion() {
            console.log("generateQuestion function triggered.");

            const inputText = document.getElementById("inputText").value;
            console.log("Input text:", inputText);

            if (!inputText) {
                alert("Please enter some text.");
                console.error("Input text is empty.");
                return;
            }

            // Show loading indicators for all sections
            const sections = ['generalQuestion', 'mcqQuestion', 'trueFalseQuestion', 'codingQuestion'];
            sections.forEach(id => {
                document.getElementById(id).innerHTML = `
                    <div class="loading-indicator">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <span class="ms-2">Generating...</span>
                    </div>
                `;
            });

            // Disable the generate button during processing
            const generateButton = document.querySelector('button.btn-primary');
            generateButton.disabled = true;
            generateButton.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Generating...';

            const endpoints = [
                { url: '/api/Chatbot/generate-question', type: 'General Question', elementId: 'generalQuestion' },
                { url: '/api/Chatbot/generate-mcq', type: 'MCQ', elementId: 'mcqQuestion' },
                { url: '/api/Chatbot/generate-truefalse', type: 'True/False', elementId: 'trueFalseQuestion' },
                { url: '/api/Chatbot/generate-coding', type: 'Coding Question', elementId: 'codingQuestion' }
            ];

            // Process each endpoint independently
            const promises = endpoints.map(async (endpoint) => {
                console.log(`Calling endpoint: ${endpoint.url} for ${endpoint.type}`);

                try {
                    const response = await fetch(endpoint.url, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ text: inputText })
                    });

                    console.log(`Response status for ${endpoint.type}:`, response.status);

                    let output = '';

                    if (response.ok) {
                        try {
                            const data = await response.json();
                            console.log(`Response data for ${endpoint.type}:`, data);

                            if (endpoint.type === 'MCQ' && data.options && data.options.length >= 4) {
                                output = `
                                    <strong>Question:</strong> ${data.question}<br>
                                    <strong>Options:</strong><br>
                                    A) ${data.options[0]}<br>
                                    B) ${data.options[1]}<br>
                                    C) ${data.options[2]}<br>
                                    D) ${data.options[3]}<br>
                                    <strong>Correct Answer:</strong> ${data.correctAnswer}
                                `;
                            } else if (endpoint.type === 'True/False' && data.statement) {
                                output = `
                                    <strong>Statement:</strong> ${data.statement}<br>
                                    <strong>Correct Answer:</strong> ${data.correctAnswer}
                                `;
                            } else if (data.question) {
                                output = `<strong>${endpoint.type}:</strong> ${data.question}`;
                            } else {
                                // Handle unexpected response structure
                                throw new Error("Invalid response format");
                            }

                            // Add the answer to the output
                            if (data.answer) {
                                output += `<br><strong>Answer:</strong> ${data.answer}`;
                            }
                        } catch (parseError) {
                            console.error(`JSON parse error for ${endpoint.type}:`, parseError);
                            output = `<span class="text-danger">Failed to parse response for ${endpoint.type}. Please try again.</span>`;
                        }
                    } else {
                        const errorText = await response.text();
                        console.error(`Error response for ${endpoint.type}:`, errorText);
                        output = `<span class="text-danger">Failed to generate ${endpoint.type}. Server returned ${response.status}.</span>`;
                    }

                    // Update the UI with the result and apply fade-in effect
                    const element = document.getElementById(endpoint.elementId);
                    element.innerHTML = output;
                    element.classList.add('fade-in');

                    // Fix for fade-in animation - add show class after a brief delay
                    setTimeout(() => {
                        element.classList.add('show');
                    }, 50);

                } catch (error) {
                    console.error(`Exception for ${endpoint.type}:`, error);
                    const element = document.getElementById(endpoint.elementId);
                    element.innerHTML = `<span class="text-danger">Error: ${error.message}</span>`;
                    element.classList.add('fade-in', 'show');
                }
            });

            // Wait for all requests to complete
            await Promise.allSettled(promises);

            // Re-enable the generate button
            generateButton.disabled = false;
            generateButton.innerHTML = 'Generate Questions';
        }

        // Add this initialization when the page loads
        document.addEventListener('DOMContentLoaded', function() {
            // Clear any previous fade-in classes
            const resultElements = document.querySelectorAll('.result-content');
            resultElements.forEach(el => {
                el.classList.remove('fade-in', 'show');
            });
        });
    </script>

    <style>
        .loading-indicator {
            display: flex;
            align-items: center;
            padding: 10px;
            background-color: #f8f9fa;
            border-radius: 5px;
        }

        /* Add a fade-in effect using CSS transitions */
        .fade-in {
            opacity: 0;
            transform: translateY(10px);
            transition: opacity 0.3s ease-in-out, transform 0.3s ease-in-out;
        }

            .fade-in.show {
                opacity: 1;
                transform: translateY(0);
            }
    </style>
}
<div class="card mb-4">
    <div class="card-header">
        <h4>Generate a Question</h4>
    </div>
    <div class="card-body">
        <textarea id="inputText" class="form-control" rows="4" placeholder="Enter text here..."></textarea>
        <button class="btn btn-primary mt-3" onclick="generateQuestion()">Generate Questions</button>

        <div class="results mt-4">
            <div class="card mb-3">
                <div class="card-header bg-light">
                    <h5 class="mb-0">General Question</h5>
                </div>
                <div class="card-body">
                    <p id="generalQuestion" class="result-content fade-in mb-0">Enter text and click Generate Questions to see results.</p>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header bg-light">
                    <h5 class="mb-0">MCQ</h5>
                </div>
                <div class="card-body">
                    <p id="mcqQuestion" class="result-content fade-in mb-0">Enter text and click Generate Questions to see results.</p>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header bg-light">
                    <h5 class="mb-0">True/False Question</h5>
                </div>
                <div class="card-body">
                    <p id="trueFalseQuestion" class="result-content fade-in mb-0">Enter text and click Generate Questions to see results.</p>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Coding Question</h5>
                </div>
                <div class="card-body">
                    <p id="codingQuestion" class="result-content fade-in mb-0">Enter text and click Generate Questions to see results.</p>
                </div>
            </div>
        </div>
    </div>
</div>
