@model Course_station.Controllers.LearnersController.AvailableQuestsViewModel

@{
    ViewData["Title"] = "Available Quests";
}

<h2>Available Quests</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">
        @TempData["Message"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Description</th>
            <th>Difficulty Level</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var quest in Model.Quests)
        {
            <tr>
                <td>@quest.Title</td>
                <td>@quest.Description</td>
                <td>@quest.DifficultyLevel</td>
                <td>
                    @if (Model.HasJoinedQuest(quest.QuestId))
                    {
                        <span class="text-success">Already Joined</span>
                    }
                    else
                    {
                        <a asp-action="JoinQuest" asp-route-learnerId="@Model.LearnerId" asp-route-questId="@quest.QuestId" class="btn btn-primary">Join</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Home" class="btn btn-secondary">Back to Home</a>