@model Course_station.Models.Assessment

@{
    ViewData["Title"] = "Assessment Details";
}

<h2 class="text-primary">@ViewData["Title"]</h2>

<div class="card mb-4">
    <div class="card-header bg-info text-white">
        <h4>@Model.Title</h4>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@Model.Description</dd>
            <dt class="col-sm-3">Total Marks</dt>
            <dd class="col-sm-9">@Model.TotalMarks</dd>
            <dt class="col-sm-3">Passing Marks</dt>
            <dd class="col-sm-9">@Model.PassingMarks</dd>
        </dl>
    </div>
</div>

<h3 class="text-secondary">Score Analytics</h3>
<div class="card mb-4">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Average Score</dt>
            <dd class="col-sm-9">@ViewBag.AverageScore</dd>
            <dt class="col-sm-3">Highest Score</dt>
            <dd class="col-sm-9">@ViewBag.HighestScore</dd>
            <dt class="col-sm-3">Lowest Score</dt>
            <dd class="col-sm-9">@ViewBag.LowestScore</dd>
        </dl>
    </div>
</div>

<h3 class="text-secondary">Taken Assessments</h3>
<div class="card mb-4">
    <div class="card-body">
        <table class="table table-striped">
            <thead class="thead-dark">
                <tr>
                    <th>Learner</th>
                    <th>Score</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var takenAssessment in Model.TakenAssessments)
                {
                    <tr>
                        <td>@takenAssessment.Learner.FirstName @takenAssessment.Learner.LastName</td>
                        <td>@takenAssessment.ScoredPoint</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
